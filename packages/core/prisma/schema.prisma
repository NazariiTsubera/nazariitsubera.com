generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VendorStatus {
  captured
  generating
  preview_live
  expired
  won
  lost
  churned
}

enum VendorTier {
  none
  free
  storefront
}

enum AuthoredBy {
  model
  template
}

enum EventType {
  vendor_created
  capture_uploaded
  asset_uploaded
  generation_started
  generation_succeeded
  generation_failed
  sms_link_tapped
  preview_published
  preview_opened
  preview_extended
  preview_expired
  unpublished
  marked_won
  marked_lost
}

model Market {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  city         String
  address      String?
  mapsUrl      String?
  scheduleNote String?
  createdAt    DateTime @default(now())
  vendors      Vendor[]
}

model Vendor {
  id                 String        @id @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  businessName       String
  contactName        String?
  phone              String
  instagramHandle    String?
  marketId           String?
  market             Market?       @relation(fields: [marketId], references: [id])
  bestSellerNote     String?
  slug               String        @unique
  status             VendorStatus  @default(captured)
  tier               VendorTier    @default(none)
  photoConsent       Boolean       @default(false)
  consentText        String?
  consentAt          DateTime?
  previewToken       String        @unique @default(uuid())
  previewExpiresAt   DateTime?
  previewOpenedAt    DateTime?
  publishedVersionId String?       @unique
  publishedVersion   SiteVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  themeOverride      String?
  designNotes        String?
  customDomain       String?       @unique
  showInPortfolio    Boolean       @default(false)
  notes              String?
  versions           SiteVersion[] @relation("VendorVersions")
  events             Event[]
  captures           Capture[]
  assets             Asset[]
  jobs               Job[]
}

enum TranscriptStatus {
  none
  pending
  done
  failed
}

enum AssetKind {
  product
  scene
  person
}

enum AssetStatus {
  uploaded
  processed
  failed
}

model Capture {
  id               String           @id @default(uuid())
  vendorId         String
  vendor           Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  audioKey         String
  audioMime        String
  audioBytes       Int
  audioSha256      String
  durationSec      Int?
  transcript       String?
  transcriptStatus TranscriptStatus @default(none)
  operatorPrompt   String?
  createdAt        DateTime         @default(now())

  @@unique([vendorId, audioSha256])
}

model Asset {
  id          String      @id @default(uuid())
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  originalKey String
  contentType String
  bytes       Int
  sha256      String
  kind        AssetKind   @default(product)
  orderIndex  Int         @default(0)
  isHero      Boolean     @default(false)
  alt         String?
  cutoutKey   String?
  derived     Json?
  status      AssetStatus @default(uploaded)
  error       String?
  createdAt   DateTime    @default(now())

  @@unique([vendorId, sha256])
  @@index([vendorId, orderIndex])
}

model SiteVersion {
  id           String     @id @default(uuid())
  vendorId     String
  vendor       Vendor     @relation("VendorVersions", fields: [vendorId], references: [id], onDelete: Cascade)
  version      Int
  contentJson  Json
  authoredBy   AuthoredBy
  themeId      String?
  html         String
  renderFlags  Json
  gateReport   Json?
  createdAt    DateTime   @default(now())
  publishedFor Vendor?    @relation("PublishedVersion")

  @@unique([vendorId, version])
}

enum JobType {
  generate_site
  regenerate_content
  regenerate_design
  edit_design
  reprocess_assets
  republish
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

model Job {
  id         String    @id @default(uuid())
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type       JobType
  status     JobStatus @default(queued)
  attempts   Int       @default(0)
  bullJobId  String?
  payload    Json      @default("{}")
  steps      Json      @default("[]")
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([vendorId, createdAt])
  @@index([status])
}

model Event {
  id        String    @id @default(uuid())
  vendorId  String?
  vendor    Vendor?   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type      EventType
  meta      Json      @default("{}")
  createdAt DateTime  @default(now())

  @@index([vendorId, createdAt])
}

// Better Auth owns these four models. Only the operator ever has an account:
// sign-up is disabled and the row is created by scripts/seed-operator.ts.
model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
