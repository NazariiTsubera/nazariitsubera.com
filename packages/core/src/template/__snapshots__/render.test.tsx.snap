:root{--bg:#FBF6EE;--surface:#FFFFFF;--ink:#2B2118;--muted:#6B5D50;--accent:#B8462B;--on-accent:#FFFFFF;--ground:#F3EBDF;--border:#E7DCCB;--radius-sm:6px;--radius-md:12px;--radius-lg:20px;--unit:1rem;--font-heading:"Fraunces Variable",Georgia, 'Times New Roman', serif;--font-body:"Source Sans 3 Variable",system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;--heading-weight:600;--heading-tracking:-0.015em;color-scheme:light dark;}
