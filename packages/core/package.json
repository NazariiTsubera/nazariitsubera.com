{
  "name": "@nazariitsubera/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./themes": "./src/themes/index.ts",
    "./template": "./src/template/index.ts",
    "./env": "./src/env/index.ts",
    "./logger": "./src/logger/index.ts",
    "./db": "./src/db/index.ts",
    "./hosting": "./src/hosting/index.ts",
    "./sites": "./src/sites/index.ts",
    "./storage": "./src/storage/index.ts",
    "./auth": "./src/auth/index.ts",
    "./markets": "./src/markets/index.ts",
    "./vendors": "./src/vendors/index.ts",
    "./assets": "./src/assets/index.ts",
    "./captures": "./src/captures/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "render:fixture": "tsx scripts/render-fixture.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "CI=1 node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js studio",
    "test:integration": "node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "publish:fixture": "node --env-file-if-exists=../../.env --import tsx scripts/publish-fixture.ts",
    "seed:operator": "node --env-file-if-exists=../../.env --import tsx scripts/seed-operator.ts",
    "seed:markets": "node --env-file-if-exists=../../.env --import tsx scripts/seed-markets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
