{
  "name": "nazariitsubera",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"pnpm --filter web dev\" \"pnpm --filter worker dev\"",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "bash scripts/integration-test.sh",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "worker": "pnpm --filter worker start"
  },
  "devDependencies": {
    "concurrently": "^10.0.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
